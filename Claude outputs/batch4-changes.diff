+    // ============================================================
+    // SEASONS (SEASON WORK, batch 4)
+    // GET /api/v1/seasons/effective?date=yyyy-MM-dd
+    // ============================================================
+    // The season whose races are used to predict a race on `date`: the season
+    // containing it or, between seasons (the special November race), the one
+    // that has just ended. Null if no season covers the date (404).
+    public async Task<SeasonDto?> GetEffectiveSeasonAsync(
+        DateOnly date,
+        CancellationToken ct = default)
+    {
+        var dateStr = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+        var url = $"/api/v1/seasons/effective?date={Uri.EscapeDataString(dateStr)}";
+
+        using var resp = await _http.GetAsync(url, ct);
+
+        if (resp.StatusCode == HttpStatusCode.NotFound)
+            return null;
+
+        resp.EnsureSuccessStatusCode();
+
+        return await resp.Content.ReadFromJsonAsync<SeasonDto>(cancellationToken: ct);
+    }
 }
 
