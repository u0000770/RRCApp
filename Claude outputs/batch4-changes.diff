+// --------------------
+// Seasons (SEASON WORK, batch 4)
+// --------------------
+// Lets MobApp (and any future client) read the seasons from config.Season
+// instead of hard-coding dates. A season is StartDate..EndDate inclusive.
+
+// GET /api/v1/seasons  — all seasons, newest first
+v1.MapGet("/seasons",
+    async (ISeasonService seasons, CancellationToken ct) =>
+    {
+        var list = await seasons.ListAsync(ct);
+        return Results.Ok(list.Select(ToSeasonDto).ToList());
+    })
+    .RequireRateLimiting("public")
+    .WithOpenApi();
+
+// GET /api/v1/seasons/effective?date=2026-11-20
+// The season whose races are used to predict a race on `date`: the season
+// containing it or, between seasons (the special November race), the one that
+// has just ended. `date` defaults to today. 404 if before the first season.
+v1.MapGet("/seasons/effective",
+    async (DateOnly? date, ISeasonService seasons, IClock clock, CancellationToken ct) =>
+    {
+        var d = date ?? clock.Today;
+        var season = await seasons.GetEffectiveAsync(d, ct);
+
+        return season is null
+            ? Results.NotFound(new ApiErrorDto($"No season covers {d:yyyy-MM-dd}.", "NOT_FOUND"))
+            : Results.Ok(ToSeasonDto(season));
+    })
+    .RequireRateLimiting("public")
+    .WithOpenApi();
+
+static SeasonDto ToSeasonDto(SeasonInfo s)
+    => new(s.SeasonId, s.Name, s.StartDate, s.EndDate, s.AllowNoTarget);
+
 app.Run();
 
 
