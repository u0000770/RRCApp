@rendermode InteractiveServer
@page "/raceeventresults/{RaceEventId:int}"

@using RRCServices
@using RRCServices.Runner
@inject IRaceResultService ResultsService
@inject IRunnerService RunnerService

<h3>Race Results</h3>

@if (_loading)
{
    <p>Loading…</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_page is null)
{
    <div class="alert alert-warning">Race event not found.</div>
}
else
{
    <div class="mb-3">
        <div><strong>Event:</strong> @_page.EventTitle</div>
        <div><strong>Date:</strong> @_page.Date</div>
        <div><strong>Distance:</strong> @_page.DistanceCode</div>
    </div>

    <!-- ✅ Add runner with ACTUAL time (predicted optional; create row if missing) -->
    <div class="card mb-3">
        <div class="card-body">

            <div class="d-flex flex-column flex-md-row gap-2 align-items-md-end">
                <div style="min-width:260px;">
                    <label class="form-label mb-1">Find runner</label>
                    <input class="form-control"
                           placeholder="Search by name…"
                           @bind="_addSearch"
                           @bind:after="ReloadAddCandidatesAsync" />

                    @if (_addCandidates.Count > 0)
                    {
                        <select class="form-select mt-2"
                                @bind="_addRunnerId"
                                @bind:after="OnAddRunnerSelected">
                            <option value="">-- select runner --</option>
                            @foreach (var r in _addCandidates)
                            {
                                <option value="@r.Id">@r.Name (@r.Ukan)</option>
                            }
                        </select>
                    }
                </div>

                <div class="flex-grow-1"></div>

                <div style="min-width:180px;">
                    <label class="form-label mb-1">Actual time (HH:MM:SS)</label>
                    <input class="form-control"
                           placeholder="00:00:00"
                           @bind="_addActualHms"
                           disabled="@(_addRunnerId is null)" />
                </div>

                <div>
                    <button class="btn btn-success"
                            disabled="@(_saving || _addRunnerId is null)"
                            @onclick="AddOrSetActualForSelectedRunnerAsync">
                        Add / Set actual
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_addMessage))
            {
                <div class="text-muted mt-2">@_addMessage</div>
            }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <p class="text-muted">No results available for this race event.</p>
    }
    else
    {
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th style="width:170px;">Predicted Time</th>
                    <th style="width:170px;">Actual Time</th>
                    <th style="width:260px;">Actual Time (edit)</th>
                    <th style="width:120px;">Diff (sec)</th>
                    <th style="width:120px;">Trophy Time</th>
                    <th style="width:120px;">Trophy Points</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.Dto.RunnerName</td>

                        <!-- Predicted optional -->
                        <td>@row.Dto.PredictedTime</td>

                        <!-- Actual (display, from service) -->
                        <td>@row.Dto.ActualTime</td>

                        <!-- Actual (edit, per-row binding) -->
                        <td>
                            <div class="d-flex gap-2">
                                <input class="form-control form-control-sm"
                                       style="max-width:140px;"
                                       placeholder="00:00:00"
                                       @bind="row.EditActualHms" />

                                <button class="btn btn-primary btn-sm"
                                        disabled="@_saving"
                                        @onclick="() => SaveActualAsync(row.Dto, row.EditActualHms)">
                                    Save
                                </button>
                            </div>
                        </td>

                        <td>@if(HasPredicted(row.Dto))
                            { @row.Dto.TimeDifferenceSeconds} 
                            else
                            {<span>N/A</span>}
                        </td>
                        <td>@(row.Dto.TrophyTimeSeconds?.ToString() ?? "0")</td>
                        <td>@row.Dto.TrophyPoints</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!string.IsNullOrWhiteSpace(_saveMessage))
        {
            <div class="alert alert-info">@_saveMessage</div>
        }
    }
}

@code {
    [Parameter] public int RaceEventId { get; set; }

    private bool _loading = true;
    private bool _saving = false;
    private string? _error;
    private string? _saveMessage;

    private RaceResultPageDTO? _page;

    // Per-row UI model to avoid shared edit state
    private sealed class ResultRowVm
    {
        public required RaceResultRowDTO Dto { get; init; }
        public string EditActualHms { get; set; } = "";
    }

    private List<ResultRowVm> _rows = new();

    // Add runner UI state
    private string? _addSearch;
    private List<RunnerListItemDto> _addCandidates = new();
    private int? _addRunnerId;
    private string? _addActualHms;
    private string? _addMessage;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadPageAsync();
    }

    private async Task ReloadPageAsync()
    {
        _loading = true;
        _error = null;
        _saveMessage = null;
        _page = null;
        _rows = new();

        try
        {
            // Get all rows; we filter "actual-present" here based on what your DTO actually contains
            _page = await ResultsService.GetResultsForRaceEventAsync(
                RaceEventId,
                includeOnlyCompleteTimes: false);

            if (_page?.Results is not null)
            {
                _rows = _page.Results
                    .Where(r => HasActual(r))
                    .Select(r => new ResultRowVm
                    {
                        Dto = r,
                        EditActualHms = ToColonHms(r.ActualTime)
                    })
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool HasActual(RaceResultRowDTO r)
    {
        if (r.ActualSeconds.HasValue && r.ActualSeconds.Value > 0) return true;
        return !string.IsNullOrWhiteSpace(r.ActualTime);
    }

    private static bool HasPredicted(RaceResultRowDTO r)
    {
        if (string.IsNullOrEmpty(r.PredictedTime)) return false;
        else { return true; }

    }

    private async Task ReloadAddCandidatesAsync()
    {
        _addMessage = null;

        if (string.IsNullOrWhiteSpace(_addSearch))
        {
            _addCandidates = new();
            _addRunnerId = null;
            return;
        }

        _addCandidates = (await RunnerService.GetRunnersAsync(_addSearch, includeInactive: false))
            .Take(25)
            .ToList();
    }

    private void OnAddRunnerSelected()
    {
        _addMessage = null;
        _addActualHms = null;
    }

    /// <summary>
    /// ✅ Add runner to results by setting ACTUAL time.
    /// Updates existing EventRunnerTime for (runner,raceEvent) even if it currently has no actual time.
    /// </summary>
    private async Task AddOrSetActualForSelectedRunnerAsync()
    {
        _addMessage = null;
        _saveMessage = null;

        if (_page is null || _addRunnerId is null)
            return;

        if (!TryParseHmsToSeconds(_addActualHms, out var seconds))
        {
            _addMessage = "Enter an actual time in HH:MM:SS first (e.g. 00:42:15).";
            return;
        }

        _saving = true;
        try
        {
            // ✅ FIX: check existence against ALL results, not just displayed (_rows shows actuals only)
            var existing = _page.Results?.FirstOrDefault(r => r.RunnerId == _addRunnerId.Value);

            var dto = new EventRunnerTimeUpsertDto
            {
                EventId = _page.EventId,
                RaceEventId = _page.RaceEventId,
                Date = _page.Date,
                Active = true,

                // Predicted optional; keep if we already know it, otherwise leave null
                TargetSeconds = existing?.TargetSeconds,
                ActualSeconds = seconds
            };

            bool ok;

            if (existing is not null && existing.EventRunnerTimeId > 0)
            {
                ok = await RunnerService.UpdateEventRunnerActualAsync(
                    runnerId: existing.RunnerId,
                    eventRunnerTimeId: existing.EventRunnerTimeId,
                    dto: dto);
            }
            else
            {
                var newId = await RunnerService.CreateEventRunnerTimeAsync(_addRunnerId.Value, dto);
                ok = newId > 0;
            }

            _addMessage = ok ? "Saved." : "Save failed.";
            await ReloadPageAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveActualAsync(RaceResultRowDTO row, string? editHms)
    {
        if (_page is null) return;

        _saveMessage = null;
        _addMessage = null;

        if (!TryParseHmsToSeconds(editHms, out var seconds) )
        {
            _saveMessage = "Please enter an actual time in HH:MM:SS (e.g. 00:42:15).";
            return;
        }

        _saving = true;
        try
        {
            var dto = new EventRunnerTimeUpsertDto
            {
                EventId = _page.EventId,
                RaceEventId = _page.RaceEventId,
                Date = _page.Date,
                Active = true,

                TargetSeconds = row.TargetSeconds,
                ActualSeconds = seconds
            };

            var ok = await RunnerService.UpdateEventRunnerActualAsync(
                runnerId: row.RunnerId,
                eventRunnerTimeId: row.EventRunnerTimeId,
                dto: dto);

            _saveMessage = ok ? "Saved." : "Save failed.";

            await ReloadPageAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool TryParseHmsToSeconds(string? input, out int seconds)
    {
        seconds = 0;
        if (string.IsNullOrWhiteSpace(input)) return false;

        var s = input.Trim()
            .Replace("h", "", StringComparison.OrdinalIgnoreCase)
            .Replace("m", "", StringComparison.OrdinalIgnoreCase)
            .Replace("s", "", StringComparison.OrdinalIgnoreCase);

        var parts = s.Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 3) return false;

        if (!int.TryParse(parts[0], out var hh)) return false;
        if (!int.TryParse(parts[1], out var mm)) return false;
        if (!int.TryParse(parts[2], out var ss)) return false;

        if (hh < 0 || mm < 0 || mm > 59 || ss < 0 || ss > 59) return false;

        seconds = (hh * 3600) + (mm * 60) + ss;
        return true;
    }

    private static string SecondsToHms(int totalSeconds)
    {
        if (totalSeconds <= 0) return "";
        var ts = TimeSpan.FromSeconds(totalSeconds);
        return $"{(int)ts.TotalHours:00}:{ts.Minutes:00}:{ts.Seconds:00}";
    }

    private static string ToColonHms(string? time)
    {
        if (string.IsNullOrWhiteSpace(time)) return "";

        return time.Trim()
            .Replace("h", "", StringComparison.OrdinalIgnoreCase)
            .Replace("m", "", StringComparison.OrdinalIgnoreCase)
            .Replace("s", "", StringComparison.OrdinalIgnoreCase);
    }
}
