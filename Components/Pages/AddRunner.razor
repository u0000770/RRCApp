@page "/addrunner"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using RRCServices.Runner
@using RRCServices
@inject IRunnerService RunnerService
@inject IRaceEventService RaceEventService
@inject NavigationManager Nav

<h3>Add Runner</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">
        <strong>Step 1 — Create Runner</strong>
    </div>
    <div class="card-body">

        <EditForm Model="_runnerForm" OnValidSubmit="CreateRunnerAsync" OnInvalidSubmit="RunnerInvalid">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">First name</label>
                    <InputText class="form-control" @bind-Value="_runnerForm.Firstname" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Second name</label>
                    <InputText class="form-control" @bind-Value="_runnerForm.Secondname" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">UKAN (unique)</label>
                    <InputText class="form-control" @bind-Value="_runnerForm.Ukan" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">DOB</label>
                    <InputDate TValue="DateTime?" class="form-control" @bind-Value="_runnerForm.DobDate" />
                </div>


                <div class="col-md-4">
                    <label class="form-label">Gender</label>
                    <InputSelect class="form-select" @bind-Value="_runnerForm.Gender">
                        <option value="Unknown">Unknown</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_runnerForm.Email" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Active</label>
                    <InputSelect class="form-select" @bind-Value="_runnerForm.Active">
                        <option value="">(default true)</option>
                        <option value="true">True</option>
                        <option value="false">False</option>
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Age grade code</label>
                    <InputText class="form-control" @bind-Value="_runnerForm.AgeGradeCode" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit" disabled="@_busyCreateRunner">
                    @(_busyCreateRunner ? "Creating..." : "Create Runner")
                </button>

                <a class="btn btn-outline-secondary" href="/runners">Back to list</a>
            </div>
        </EditForm>

        @if (_createdRunnerId is not null)
        {
            <hr />
            <div class="alert alert-info mb-0">
                Runner created. RunnerId: <strong>@_createdRunnerId</strong>
            </div>
        }
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(_timeError))
{
    <div class="alert alert-danger">@_timeError</div>
}
@if (!string.IsNullOrWhiteSpace(_timeSuccess))
{
    <div class="alert alert-success">@_timeSuccess</div>
}

<div class="card">
    <div class="card-header">
        <strong>Step 2 — Add EventRunnerTime</strong>
    </div>

    <div class="card-body">
        @if (_createdRunnerId is null)
        {
            <p class="text-muted mb-0">
                Create the runner first, then you can add an EventRunnerTime.
            </p>
        }
        else
        {
            <EditForm Model="_timeForm" OnValidSubmit="CreateTimeAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Distance</label>
                        <InputSelect class="form-select"
                                     @bind-Value="_selectedDistanceCode"
                                     @bind-Value:after="OnDistanceChangedAsync">
                            <option value="">-- select distance --</option>
                            @if (_lookups?.Distances is not null)
                            {
                                foreach (var d in _lookups.Distances)
                                {
                                    <option value="@d.Code">@d.Name (@d.Code)</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Event</label>
                        <InputSelect class="form-select" @bind-Value="_timeForm.EventId">
                            <option value="0">-- select event --</option>
                            @if (_eventsForDistance is not null)
                            {
                                foreach (var e in _eventsForDistance)
                                {
                                    @* If your DTO property name is Id, change EventId -> Id *@
                                    <option value="@e.Id">@e.Title</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Date</label>
                        <InputDate TValue="DateTime?" class="form-control" @bind-Value='_timeForm.Date' />
                    </div>


                

                    <div class="col-md-4">
                        <label class="form-label">Target (HH:MM:SS)</label>
                        <InputText class="form-control" placeholder="00:20:15" @bind-Value="_timeForm.TargetTimeText" />
                        <div class="form-text">Example: 00:19:30</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Actual (HH:MM:SS)</label>
                        <InputText class="form-control" placeholder="00:21:02" @bind-Value="_timeForm.ActualTimeText" />
                        <div class="form-text">Example: 00:20:45</div>
                    </div>

                  

                    <div class="col-md-4">
                        <label class="form-label">Active</label>
                        <InputSelect class="form-select" @bind-Value="_timeForm.Active">
                            <option value="">(default true)</option>
                            <option value="true">True</option>
                            <option value="false">False</option>
                        </InputSelect>
                    </div>

                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-success" type="submit" disabled="@_busyCreateTime">
                        @(_busyCreateTime ? "Saving..." : "Add EventRunnerTime")
                    </button>

                    <button class="btn btn-outline-primary" type="button" @onclick="GoToRunnerDetails">
                        Go to Runner Details
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>


