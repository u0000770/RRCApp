@page "/admin/season-settings"
@using RRCServices.Season
@inject ISeasonSettingsService SeasonSettingsService

<h3>Season Settings</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="SaveAsync"
              FormName="SeasonSettingsForm">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Season Start</label>
            <InputDate TValue="DateOnly"
                       class="form-control"
                       @bind-Value="_model.SeasonStartDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Season End</label>
            <InputDate TValue="DateOnly"
                       class="form-control"
                       @bind-Value="_model.SeasonEndDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Selection Start</label>
            <InputDate TValue="DateOnly"
                       class="form-control"
                       @bind-Value="_model.SelectionStartDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Selection End</label>
            <InputDate TValue="DateOnly"
                       class="form-control"
                       @bind-Value="_model.SelectionEndDate" />
        </div>

        <button class="btn btn-primary" type="submit">Save</button>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="mt-3 alert alert-info">@_message</div>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mt-3 alert alert-danger">@_error</div>
        }
    </EditForm>
}


