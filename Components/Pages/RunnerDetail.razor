@page "/runners/{RunnerId:int}"
@rendermode InteractiveServer

@using RRCServices.Runner
@inject IRunnerService RunnerService
@inject NavigationManager Nav

<h3>Runner Details</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else if (_runner is null)
{
    <div class="alert alert-warning">
        Runner not found.
    </div>
    <button class="btn btn-outline-secondary" @onclick="BackToList">Back</button>
}
else
{
    <!-- ================= Runner summary ================= -->
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@_runner.Name</strong>

            <button class="btn btn-outline-secondary btn-sm" @onclick="BackToList">
                Back to list
            </button>
        </div>

        <div class="card-body">
            <div class="row gy-4">

                <div class="col-md-3">
                    <div class="text-muted small">UKAN</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(_runner.Ukan) ? "—" : _runner.Ukan)
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Date of Birth</div>
                    <div class="fw-semibold">
                        @(_runner.Dob?.ToString("yyyy-MM-dd") ?? "—")
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Gender</div>
                    <div class="fw-semibold">
                        @_runner.Gender
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Active</div>
                    <div class="fw-semibold">
                        @(_runner.Active == true ? "Yes" : "No")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">Email</div>
                    <div class="fw-semibold text-break">
                        @(string.IsNullOrWhiteSpace(_runner.Email) ? "—" : _runner.Email)
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Age Grade Code</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(_runner.AgeGradeCode) ? "—" : _runner.AgeGradeCode)
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- ================= Event Times ================= -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Event Runner Times</h5>

        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   id="includeInactiveTimes"
                   @bind="_includeInactiveTimes"
                   @bind:after="ReloadAsync" />
            <label class="form-check-label" for="includeInactiveTimes">
                Include inactive times
            </label>
        </div>
    </div>

    @if (_sortedTimes.Count == 0)
    {
        <p class="text-muted">No times recorded.</p>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="cursor:pointer" @onclick='() => SortBy("Date")'>
                        Date @SortIndicator("Date")
                    </th>

                    <th style="cursor:pointer" @onclick='() => SortBy("Event")'>
                        Event @SortIndicator("Event")
                    </th>

                    <th style="cursor:pointer" @onclick='() => SortBy("Distance")'>
                        Distance @SortIndicator("Distance")
                    </th>

                    <th class="text-end">Target</th>
                    <th class="text-end">Actual</th>
                    <th class="text-end">Diff</th>

                    <th class="text-end" style="cursor:pointer"
                        @onclick='() => SortBy("AgeGrade")'>
                        Age Grade @SortIndicator("AgeGrade")
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var t in _sortedTimes)
                {
                    <tr>
                        <td>@(t.RaceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@t.RaceTitle</td>
                        <td>@t.RaceDistance</td>
                        <td class="text-end">@t.RaceTargetTime</td>
                        <td class="text-end">@t.RaceActualTime</td>
                        <td class="text-end">@t.TimeDifference</td>
                        <td class="text-end">
                            @(t.RaceActualTime == "No Result" || t.AgeGrade == 0 ? "None" : t.AgeGrade.ToString())
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code
{
    [Parameter] public int RunnerId { get; set; }

    private RunnerDetailsDto? _runner;
    private List<EventRaceTimesDto> _sortedTimes = new();

  

    private bool _loading = true;
    private string? _error;

    private bool _includeInactiveTimes = false;

    // Sorting
    private string _sortColumn = "Date";
    private bool _sortAscending = false; // most recent first by default

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            _runner = await RunnerService.GetRunnerDetailsAsync(
                RunnerId,
                includeInactiveTimes: _includeInactiveTimes);

            if (_runner is not null)
            {
                _sortedTimes = _runner.EventTimes.ToList();
                ApplySort();
            }
            else
            {
                _sortedTimes.Clear();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _runner = null;
            _sortedTimes.Clear();
        }
        finally
        {
            _loading = false;
        }
    }


    // ----------------------------
    // Sorting logic
    // ----------------------------
    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        _sortedTimes = (_sortColumn, _sortAscending) switch
        {
            ("Date", true) =>
                _sortedTimes.OrderBy(t => t.RaceDate).ToList(),

            ("Date", false) =>
                _sortedTimes.OrderByDescending(t => t.RaceDate).ToList(),

            ("Event", true) =>
                _sortedTimes.OrderBy(t => t.RaceTitle).ToList(),

            ("Event", false) =>
                _sortedTimes.OrderByDescending(t => t.RaceTitle).ToList(),

            ("Distance", true) =>
                _sortedTimes.OrderBy(t => t.RaceDistance).ToList(),

            ("Distance", false) =>
                _sortedTimes.OrderByDescending(t => t.RaceDistance).ToList(),

            ("AgeGrade", true) =>
                _sortedTimes.OrderBy(t => t.AgeGrade).ToList(),

            ("AgeGrade", false) =>
                _sortedTimes.OrderByDescending(t => t.AgeGrade).ToList(),

            _ => _sortedTimes
        };
    }

    private string SortIndicator(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private void BackToList()
        => Nav.NavigateTo("/runners");
}
