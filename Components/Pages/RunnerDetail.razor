@page "/runners/{RunnerId:int}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations;
@using RRCServices.Calculator
@using RRCServices.Runner
   
@inject IRunnerService RunnerService
@inject NavigationManager Nav
@inject CalculatorService CalculatorService


<style>
    .field {
        line-height: 1.2;
    }

    .field-label {
        color: #6c757d; /* Bootstrap muted-ish */
        font-size: 0.95rem;
        margin-bottom: 0.35rem;
    }

    .field-value {
        font-size: 1.15rem;
        font-weight: 500;
        word-break: break-word;
    }
</style>
<h3>Runner Details</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else if (_runner is null)
{
    <div class="alert alert-warning">
        Runner not found.
    </div>
    <button class="btn btn-outline-secondary" @onclick="BackToList">Back</button>
}
else
{
   <!-- ================= Runner summary (editable) ================= -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>@(_runner?.Name ?? "Runner")</strong>

        <div class="d-flex gap-2">
            @if (!_editing)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="BeginEdit">
                    Edit
                </button>
            }
            else
            {
                <button class="btn btn-success btn-sm" @onclick="SaveRunnerAsync" disabled="@_busySave">
                    @(_busySave ? "Saving..." : "Save")
                </button>

                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit" disabled="@_busySave">
                    Cancel
                </button>
            }

                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="() => CalcRace(RunnerId)">
                    Calculator
                </button>

            <button class="btn btn-outline-secondary btn-sm" @onclick="BackToList">
                Back to list
            </button>
        </div>
    </div>

    <div class="card-body">
        @if (_runner is null)
        {
            <p class="text-muted mb-0">No runner loaded.</p>
        }
        else if (!_editing)
        {
            <!-- Read-only view -->
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">UKAN</div>
                                <div class="field-value">@(_runner.Ukan ?? "-")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">Date of Birth</div>
                                <div class="field-value">@(_runner.Dob is null ? "-" : _runner.Dob.Value.ToString("yyyy-MM-dd"))</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">Gender</div>
                                <div class="field-value">@_runner.Gender</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">Active</div>
                                <div class="field-value">@(_runner.Active == true ? "Yes" : "No")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">Email</div>
                                <div class="field-value">@(!string.IsNullOrWhiteSpace(_runner.Email) ? _runner.Email : "—")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="field">
                                <div class="field-label">Age Grade Code</div>
                                <div class="field-value">@(!string.IsNullOrWhiteSpace(_runner.AgeGradeCode) ? _runner.AgeGradeCode : "—")</div>
                            </div>
                        </div>
                    </div>
                </div>

        }
        else
        {
            <!-- Edit view -->
            <EditForm Model="_editForm" OnValidSubmit="SaveRunnerAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First name</label>
                        <InputText class="form-control" @bind-Value="_editForm.Firstname" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Second name</label>
                        <InputText class="form-control" @bind-Value="_editForm.Secondname" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">UKAN</label>
                        <InputText class="form-control" @bind-Value="_editForm.Ukan" />
                    </div>

                        <div class="col-md-4">
                            <label class="form-label">DOB</label>
                            <InputDate TValue="DateOnly?" class="form-control" @bind-Value="_editForm.Dob" />
                        </div>

                    <div class="col-md-4">
                        <label class="form-label">Gender</label>
                        <InputSelect class="form-select" @bind-Value="_editForm.Gender">
                            <option value="Unknown">Unknown</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_editForm.Email" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Active</label>
                        <InputSelect class="form-select" @bind-Value="_editForm.Active">
                            <option value="">(leave unchanged)</option>
                            <option value="true">True</option>
                            <option value="false">False</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Age Grade Code</label>
                        <InputText class="form-control" @bind-Value="_editForm.AgeGradeCode" />
                    </div>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        Tip: UKAN must be unique. Leave Active blank to keep current value.
                    </small>
                </div>
            </EditForm>
        }
    </div>
</div>



    <!-- ================= Event Times ================= -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Event Runner Times</h5>

        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   id="includeInactiveTimes"
                   @bind="_includeInactiveTimes"
                   @bind:after="ReloadAsync" />
            <label class="form-check-label" for="includeInactiveTimes">
                Include inactive times
            </label>
        </div>
    </div>

    @if (_sortedTimes.Count == 0)
    {
        <p class="text-muted">No times recorded.</p>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="cursor:pointer" @onclick='() => SortBy("Date")'>
                        Date @SortIndicator("Date")
                    </th>

                    <th style="cursor:pointer" @onclick='() => SortBy("Event")'>
                        Event @SortIndicator("Event")
                    </th>

                    <th style="cursor:pointer" @onclick='() => SortBy("Distance")'>
                        Distance @SortIndicator("Distance")
                    </th>

                    <th class="text-end">Target</th>
                    <th class="text-end">Actual</th>
                    <th class="text-end">Diff</th>

                    <th class="text-end" style="cursor:pointer"
                        @onclick='() => SortBy("AgeGrade")'>
                        Age Grade @SortIndicator("AgeGrade")
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var t in _sortedTimes)
                {
                    <tr>
                        <td>@(t.RaceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@t.RaceTitle</td>
                        <td>@t.RaceDistance</td>
                        <td class="text-end">@t.RaceTargetTime</td>
                        <td class="text-end">@t.RaceActualTime</td>
                        <td class="text-end">@t.TimeDifference</td>
                        <td class="text-end">
                            @(t.RaceActualTime == "No Result" || t.AgeGrade == 0 ? "None" : t.AgeGrade.ToString())
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}


