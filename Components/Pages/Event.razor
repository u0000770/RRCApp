@rendermode InteractiveServer
@page "/events"

@using RRCServices
@inject EventService EventsService
@inject DisciplineService DisciplineService
@inject DistanceService DistanceService

<h3>Events</h3>

@if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
              @*   <th style="width:80px;">Id</th> *@
                <th style="cursor:pointer" @onclick='() => SortBy("Title")'>Title</th>
                <th style="cursor:pointer" @onclick='() => SortBy("Venue")'>Venue</th>
                <th style="cursor:pointer" @onclick='() => SortBy("Discipline")'>Discipline</th>
                <th style="cursor:pointer" @onclick='() => SortBy("Distance")'>Distance</th>
                <th style="cursor:pointer" @onclick='() => SortBy("Active")'>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _items)
            {
                <tr>
                   @*  <td>@e.Id</td> *@

                    <td>
                        @if (_editingId == e.Id)
                        {
                            <InputText class="form-control" @bind-Value="_editModel.Title" />
                        }
                        else
                        {

                            @e.Title
                        }
                    </td>

                    <td>
                        @if (_editingId == e.Id)
                        {
                            <InputText class="form-control" @bind-Value="_editModel.Venue" />
                        }
                        else
                        {

                            @e.Venue
                        }
                    </td>

                    <td>
                        @if (_editingId == e.Id)
                        {
                            @* Store the Discipline "Code" (or Name) into EventDTO.Discipline *@
                            <InputSelect class="form-select" @bind-Value="_editModel.Discipline">
                                <option value="">-- select --</option>
                                @foreach (var d in _disciplines)
                                {
                                    <option value="@d.Code">@d.Name (@d.Code)</option>
                                }
                            </InputSelect>
                        }
                        else
                        {

                            @e.Discipline
                        }
                    </td>

                    <td>
                        @if (_editingId == e.Id)
                        {
                            <InputSelect class="form-select" @bind-Value="_editModel.DistanceCode">
                                <option value="">-- select --</option>
                                @foreach (var d in _distances)
                                {
                                    <option value="@d.Code">@d.Name (@d.Code)</option>
                                }
                            </InputSelect>
                        }
                        else
                        {

                            @e.DistanceCode
                        }
                    </td>

                    <td class="text-center">
                        @if (_editingId == e.Id)
                        {
                            <InputCheckbox class="form-check-input" @bind-Value="_editActive" />
                        }
                        else
                        {
                            @(e.Active == true ? "Yes" : "No")
                        }
                    </td>

                    <td>
                        @if (_editingId == e.Id)
                        {
                            <button class="btn btn-primary me-2" type="button" @onclick="SaveEditAsync">Save</button>
                            <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary me-2" type="button" @onclick="() => StartEdit(e)">Edit</button>
                           @*  <button class="btn btn-outline-danger" type="button" @onclick="() => HardDeleteAsync(e.Id)">Delete</button> *@
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h5>Add new</h5>

    <EditForm Model="_newModel" OnValidSubmit="AddAsync">
        <DataAnnotationsValidator />

        <div class="row g-2">
            <div class="col-md-3">
                <InputText class="form-control" placeholder="Title" @bind-Value="_newModel.Title" />
            </div>
            <div class="col-md-3">
                <InputText class="form-control" placeholder="Venue" @bind-Value="_newModel.Venue" />
            </div>

            <div class="col-md-2">
                <InputSelect class="form-select" @bind-Value="_newModel.Discipline">
                    <option value="">-- discipline --</option>
                    @foreach (var d in _disciplines)
                    {
                        <option value="@d.Code">@d.Name (@d.Code)</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-2">
                <InputSelect class="form-select" @bind-Value="_newModel.DistanceCode">
                    <option value="">-- distance --</option>
                    @foreach (var d in _distances)
                    {
                        <option value="@d.Code">@d.Name (@d.Code)</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-1 d-flex align-items-center gap-2">
                <InputCheckbox class="form-check-input" @bind-Value="_newActive" />
                <span>Active</span>
            </div>

            <div class="col-md-1">
                <button class="btn btn-success w-100" type="submit">Add</button>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mt-3">@_error</div>
    }
}



