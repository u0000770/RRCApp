@rendermode InteractiveServer
@page "/disciplines"

@using RRCServices
@inject DisciplineService Service

<h3>Disciplines</h3>

@if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th style="width:80px;">Id</th>
                <th style="width:180px;">Code</th>
                <th>Name</th>
                <th style="width:360px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _items)
            {
                <tr>
                    <td>@d.id</td>

                    <td>
                        @if (_editingId == d.id)
                        {
                            <InputText class="form-control" @bind-Value="_editModel.Code" />
                        }
                        else
                        {
                            @d.Code
                        }
                    </td>

                    <td>
                        @if (_editingId == d.id)
                        {
                            <InputText class="form-control" @bind-Value="_editModel.Name" />
                        }
                        else
                        {
                            @d.Name
                        }
                    </td>

                    <td>
                        @if (_editingId == d.id)
                        {
                            <EditForm Model="_editModel" OnValidSubmit="SaveEditAsync">
                                <DataAnnotationsValidator />
                                <button class="btn btn-primary me-2" type="submit">Save</button>
                                <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                            </EditForm>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary me-2" type="button" @onclick="() => StartEdit(d)">Edit</button>

                            <button class="btn btn-outline-warning me-2" type="button"
                                    title="Soft delete (Active=false)"
                                    @onclick="() => SoftDeleteAsync(d.id)">
                                Soft delete
                            </button>

                            <button class="btn btn-outline-danger" type="button"
                                    title="Hard delete (permanent)"
                                    @onclick="() => HardDeleteAsync(d.id)">
                                Hard delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h5>Add new</h5>

    <EditForm Model="_newModel" OnValidSubmit="AddAsync">
        <DataAnnotationsValidator />
        <div class="row g-2">
            <div class="col-md-3">
                <InputText class="form-control" placeholder="Code" @bind-Value="_newModel.Code" />
            </div>

            <div class="col-md-7">
                <InputText class="form-control" placeholder="Name" @bind-Value="_newModel.Name" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-success w-100" type="submit">Add</button>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mt-3">@_error</div>
    }
}



