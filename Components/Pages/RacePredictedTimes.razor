@page "/raceeventprediction"
@rendermode InteractiveServer

@using RRCServices.Calculator.RRCServices  @* adjust if your namespace differs *@
@inject IRacePredictionService PredictionService

<PageTitle>Race Targets</PageTitle>

<h1>Race Targets</h1>



<div class="d-flex gap-2 mb-4">
    <button class="btn btn-primary"
            @onclick="RunPrediction"
            disabled="@_running">
        @(_running ? "Running..." : "Run prediction (Calculate Times)")
    </button>

    <button class="btn btn-success"
            @onclick="ConfirmApply"
            disabled="@(_running || _results.Count == 0)">
        Confirm (publish targets)
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="alert alert-info">@_info</div>
}

@if (_results.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body">
            <h4 class="mb-1">@_raceTitle</h4>
            <div class="text-muted">Race date: <strong>@_raceDateText</strong></div>
            <div class="text-muted">Predictions: <strong>@_results.Count</strong> runner(s)</div>
        </div>
    </div>

    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>UKAN</th>
                <th>Name</th>
                <th>Runner Predicted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _results)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(row.Ukan) ? "-" : row.Ukan)</td>
                    <td>@(string.IsNullOrWhiteSpace(row.RunnerName) ? "-" : row.RunnerName)</td>
                    <td>@FormatHms(row.PredictedTargetSeconds)</td>
                </tr>
            }
        </tbody>
    </table>
}


