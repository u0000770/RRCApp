@page "/calcrunnerrace"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text.RegularExpressions
@using RRCServices
@using RRCServices.Calculator
@using RRCServices.Clock
@using RRCServices.Runner
@using RRCServices.Season

@inject NavigationManager Nav
@inject IRunnerService RunnerService
@inject IRaceEventService RaceEventService
@inject IClock Clock
@inject ISeasonSettingsService SeasonSettingsService

<PageTitle>Race Calculator</PageTitle>

<h3>Race Calculator</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_runner is null)
{
    <div class="alert alert-warning">
        Runner not found.
    </div>
    <button class="btn btn-secondary" @onclick="BackToRunners">Back</button>
}
else
{
    <div class="mb-3">
        <strong>Runner:</strong> @_runner.Name
        @if (!string.IsNullOrWhiteSpace(_runner.Ukan))
        {
            <span class="text-muted">(@_runner.Ukan)</span>
        }
        <div class="text-muted">
            Hypothetical today: <strong>@Clock.Now.ToString("dd MMM yyyy")</strong>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">Select race event (past 3 + next 3)</label>

                @if (_raceEvents.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No race events found around the selected "today" date.
                    </div>
                }
                else
                {
                    <!-- ✅ Option A: @bind only (no @onchange), react in property setter -->
                    <select class="form-select" @bind="SelectedRaceEventId">
                        <option value="">-- choose a race event --</option>

                        @if (_past3.Count > 0)
                        {
                            <optgroup label="Past (most recent first)">
                                @foreach (var re in _past3)
                                {
                                    <option value="@re.RaceEventId">
                                        @FormatRaceEvent(re)
                                    </option>
                                }
                            </optgroup>
                        }

                        @if (_next3.Count > 0)
                        {
                            <optgroup label="Upcoming (soonest first)">
                                @foreach (var re in _next3)
                                {
                                    <option value="@re.RaceEventId">
                                        @FormatRaceEvent(re)
                                    </option>
                                }
                            </optgroup>
                        }
                    </select>
                }
            </div>

            @if (_selectedRaceEvent is not null)
            {
                <div class="mb-3">
                    <div>
                        <strong>Selected:</strong> @FormatRaceEvent(_selectedRaceEvent)
                    </div>

                    @if (_existingForSelected is not null && _existingForSelected.TargetTime > 0)
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            This runner already has a target time for this race:
                            <strong>@_existingForSelected.RaceTargetTime</strong>.
                            Updating will overwrite it.
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <button class="btn btn-primary"
                            @onclick="Calculate"
                            disabled="@(_selectedRaceEvent is null)">
                        Calculate predicted target time
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_calcMessage))
                {
                    <div class="alert alert-info">@_calcMessage</div>
                }

                @if (_predictedSeconds is not null)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Predicted target time:</strong>
                                <span class="fs-5">@FormatSeconds(_predictedSeconds.Value)</span>
                            </div>

                            <button class="btn btn-success"
                                    @onclick="ConfirmUpdate"
                                    disabled="@_saving">
                                Confirm update
                            </button>

                            @if (!string.IsNullOrWhiteSpace(_saveMessage))
                            {
                                <div class="alert alert-success mt-3 mb-0">@_saveMessage</div>
                            }
                        </div>
                    </div>
                }
            }

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="BackToRunnerDetails">
                    Back to runner details
                </button>
                <button class="btn btn-outline-secondary" @onclick="BackToRunners">
                    Back to runners list
                </button>
            </div>

        </div>
    </div>
}




